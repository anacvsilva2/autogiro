<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auto Giro - Jogo de Arrancada de Moto</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome para Ícones -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #0b0e14;
            color: #f3f4f6;
            user-select: none;
            overflow-x: hidden;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        .neon-border-green {
            box-shadow: 0 0 15px rgba(34, 197, 94, 0.4);
        }
        .neon-border-red {
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
        }
        .neon-text-green {
            text-shadow: 0 0 8px rgba(34, 197, 94, 0.6);
        }
        .neon-text-yellow {
            text-shadow: 0 0 8px rgba(234, 179, 8, 0.6);
        }
        /* Gradient animations */
        .btn-speed {
            background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
            transition: all 0.15s ease;
        }
        .btn-speed:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(239, 68, 68, 0.5);
        }
        .btn-speed:active {
            transform: translateY(1px);
        }
        .glass-panel {
            background: rgba(18, 24, 38, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- HEADER / NAVIGATION -->
    <header class="border-b border-gray-800 bg-gray-950/80 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-red-600 text-white p-2 rounded-lg font-orbitron font-black text-xl italic shadow-lg shadow-red-900/50">
                    AG
                </div>
                <div>
                    <h1 class="font-orbitron font-black text-2xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-orange-400 to-yellow-400">
                        AUTO GIRO
                    </h1>
                    <p class="text-xs text-gray-400 font-semibold tracking-widest uppercase">Arrancada 420m • Protótipo v2.0</p>
                </div>
            </div>

            <!-- MENU TABS -->
            <nav class="flex gap-2 bg-gray-900/80 p-1.5 rounded-xl border border-gray-800">
                <button onclick="switchTab('race')" id="tab-race" class="px-4 py-2 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 bg-red-600 text-white shadow-md">
                    <i class="fa-solid fa-flag-checkered"></i> Pista (VS Bot)
                </button>
                <button onclick="switchTab('bikes')" id="tab-bikes" class="px-4 py-2 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 text-gray-400 hover:text-white hover:bg-gray-800">
                    <i class="fa-solid fa-motorcycle"></i> Motos
                </button>
                <button onclick="switchTab('garage')" id="tab-garage" class="px-4 py-2 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 text-gray-400 hover:text-white hover:bg-gray-800">
                    <i class="fa-solid fa-wrench"></i> Peças
                </button>
                <button onclick="switchTab('ranking')" id="tab-ranking" class="px-4 py-2 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 text-gray-400 hover:text-white hover:bg-gray-800">
                    <i class="fa-solid fa-trophy"></i> Ranking
                </button>
                <button onclick="switchTab('info')" id="tab-info" class="px-4 py-2 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 text-gray-400 hover:text-white hover:bg-gray-800">
                    <i class="fa-solid fa-users"></i> Grupo 5
                </button>
            </nav>
        </div>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="max-w-7xl mx-auto w-full px-4 py-6 flex-grow flex flex-col justify-center">

        <!-- ==================== TELA 1: CORRIDA (PISTA) ==================== -->
        <section id="sec-race" class="space-y-6">
            
            <!-- CANVAS PISTA DE CORRIDA -->
            <div class="relative rounded-2xl overflow-hidden border-2 border-gray-800 bg-gray-950 shadow-2xl">
                
                <!-- Overlay Informações Rápidas -->
                <div class="absolute top-4 left-4 z-10 flex gap-3 flex-wrap">
                    <div class="glass-panel px-4 py-2 rounded-xl border border-gray-700/50">
                        <span class="text-xs text-gray-400 uppercase font-semibold">Distância</span>
                        <div class="text-xl font-orbitron font-bold text-yellow-400" id="dist-display">0.0 m / 420m</div>
                    </div>
                    <div class="glass-panel px-4 py-2 rounded-xl border border-gray-700/50">
                        <span class="text-xs text-gray-400 uppercase font-semibold">Tempo</span>
                        <div class="text-xl font-orbitron font-bold text-green-400" id="time-display">00.000s</div>
                    </div>
                    <div class="glass-panel px-4 py-2 rounded-xl border border-cyan-500/40">
                        <span class="text-xs text-gray-400 uppercase font-semibold">Oponente</span>
                        <div class="text-xl font-orbitron font-bold text-cyan-400" id="bot-dist-display">0.0 m</div>
                    </div>
                </div>

                <!-- Tree Lights (Árvore de Natal de Arrancada) -->
                <div class="absolute top-4 right-4 z-10 glass-panel p-3 rounded-xl flex flex-col gap-2 items-center border border-gray-700/50">
                    <span class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">LARGADA</span>
                    <div class="flex gap-2">
                        <div id="light-red" class="w-5 h-5 rounded-full bg-red-950 border border-red-800 transition-all duration-150"></div>
                        <div id="light-yellow1" class="w-5 h-5 rounded-full bg-yellow-950 border border-yellow-800 transition-all duration-150"></div>
                        <div id="light-yellow2" class="w-5 h-5 rounded-full bg-yellow-950 border border-yellow-800 transition-all duration-150"></div>
                        <div id="light-green" class="w-5 h-5 rounded-full bg-green-950 border border-green-800 transition-all duration-150"></div>
                    </div>
                </div>

                <!-- Banner Mensagem / Status da Corrida -->
                <div id="race-status-banner" class="hidden absolute inset-0 z-20 bg-black/80 backdrop-blur-sm flex flex-col justify-center items-center gap-4 text-center p-6">
                    <h2 id="status-title" class="font-orbitron text-4xl font-black text-yellow-400 tracking-wider">DESAFIO DE ARRANCADA VS OPONENTE!</h2>
                    <p id="status-subtitle" class="text-gray-300 text-base max-w-lg">Engate as marchas no momento exato e atinja velocidades extremas para vencer a outra moto nos 420m!</p>
                    <button onclick="startRaceSequence()" class="btn-speed px-8 py-4 rounded-xl font-orbitron font-bold text-xl text-white shadow-lg tracking-wider">
                        <i class="fa-solid fa-play mr-2"></i> INICIAR DUELO
                    </button>
                </div>

                <!-- Canvas Render das Motos e Pista -->
                <canvas id="raceCanvas" class="w-full h-[340px] block bg-slate-900"></canvas>
            </div>

            <!-- DASHBOARD DO PILOTO -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
                
                <!-- TELEMETRIA E TROCA DE MARCHA -->
                <div class="glass-panel p-5 rounded-2xl border border-gray-800 flex flex-col justify-between h-full">
                    <div class="flex justify-between items-center mb-3">
                        <span class="text-xs uppercase text-gray-400 font-bold tracking-wider">Marcha</span>
                        <span id="gear-indicator" class="font-orbitron font-black text-3xl text-orange-500">N</span>
                    </div>

                    <div class="mb-4">
                        <div class="flex justify-between text-xs text-gray-400 mb-1 font-bold">
                            <span>RPM Ideal</span>
                            <span id="shift-feedback" class="text-yellow-400 font-orbitron">Pronto</span>
                        </div>
                        <div class="grid grid-cols-8 gap-1 bg-gray-950 p-2 rounded-xl border border-gray-800" id="shift-lights">
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                            <div class="h-3 rounded bg-gray-800 shadow-inner"></div>
                        </div>
                    </div>

                    <button id="btn-shift" onclick="shiftGear()" class="w-full py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 active:scale-95 font-orbitron font-extrabold text-lg rounded-xl shadow-lg border border-blue-400/30 transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-arrow-up text-xl"></i> PASSAR MARCHA (SHIFT / SETA CIMA)
                    </button>
                </div>

                <!-- VELOCÍMETRO CENTRAL (RPM GAUGE ULTRA RÁPIDO) -->
                <div class="glass-panel p-5 rounded-2xl border border-gray-800 flex flex-col items-center justify-center relative overflow-hidden">
                    <div class="text-center mb-2">
                        <div class="text-xs uppercase font-bold text-gray-400 tracking-wider">Velocidade Atual</div>
                        <div class="font-orbitron font-black text-6xl text-white tracking-widest flex items-baseline justify-center gap-1">
                            <span id="speed-display">0</span> <span class="text-sm font-normal text-red-500">KM/H</span>
                        </div>
                        <div class="text-xs text-gray-400 font-bold mt-1" id="current-bike-name-display">Moto: Standard 150cc</div>
                    </div>

                    <div class="w-full max-w-xs space-y-2 my-2">
                        <div class="flex justify-between text-xs font-orbitron text-gray-400">
                            <span>0</span>
                            <span>5k</span>
                            <span>10k</span>
                            <span class="text-red-500">14k RPM</span>
                        </div>
                        <div class="w-full h-5 bg-gray-950 rounded-full p-1 border border-gray-800 flex items-center relative overflow-hidden">
                            <div id="rpm-bar" class="h-full bg-gradient-to-r from-green-500 via-yellow-400 to-red-600 rounded-full transition-all duration-75" style="width: 0%;"></div>
                        </div>
                    </div>

                    <div class="text-xs text-gray-400 font-semibold mt-1">
                        RPM: <span id="rpm-text" class="text-white font-orbitron font-bold">0</span> / 14000
                    </div>
                </div>

                <!-- CONTROLES E NITRO -->
                <div class="glass-panel p-5 rounded-2xl border border-gray-800 flex flex-col justify-between h-full">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-xs uppercase text-gray-400 font-bold tracking-wider">Nitro Boost</span>
                        <span id="nitro-status" class="text-xs font-orbitron font-bold text-cyan-400">PRONTO</span>
                    </div>
                    
                    <button id="btn-nitro" onclick="useNitro()" class="w-full py-3 mb-3 bg-gradient-to-r from-cyan-600 to-blue-700 hover:from-cyan-500 hover:to-blue-600 active:scale-95 font-orbitron font-bold text-sm rounded-xl shadow-lg border border-cyan-400/30 transition-all flex items-center justify-center gap-2 text-cyan-100">
                        <i class="fa-solid fa-bolt text-yellow-300"></i> INJETAR NITRO (N)
                    </button>

                    <button id="btn-throttle" class="w-full py-5 btn-speed font-orbitron font-black text-xl rounded-xl shadow-xl border border-red-400/30 flex items-center justify-center gap-3">
                        <i class="fa-solid fa-gauge-high text-2xl"></i> ACELERAR (ESPAÇO / W)
                    </button>
                </div>

            </div>

        </section>

        <!-- ==================== TELA 2: LOJA / TROCA DE MOTOS ==================== -->
        <section id="sec-bikes" class="hidden space-y-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-gray-900/60 p-6 rounded-2xl border border-gray-800">
                <div>
                    <h2 class="font-orbitron font-extrabold text-2xl text-white">CONCESSIONÁRIA DE MOTOS</h2>
                    <p class="text-gray-400 text-sm">Compre e selecione novas motos com maior potência, torque e velocidade máxima extrema.</p>
                </div>
                <div class="glass-panel px-6 py-3 rounded-xl border border-yellow-500/30 flex items-center gap-3">
                    <i class="fa-solid fa-coins text-yellow-400 text-2xl"></i>
                    <div>
                        <span class="text-xs text-gray-400 uppercase font-bold">Saldo Disponível</span>
                        <div class="font-orbitron font-black text-2xl text-yellow-400" id="cash-display-bikes">R$ 1.500</div>
                    </div>
                </div>
            </div>

            <!-- Catálogo de Motos -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="bikes-catalog-list">
                <!-- Injetado dinamicamente via JS -->
            </div>
        </section>

        <!-- ==================== TELA 3: GARAGEM DE PEÇAS ==================== -->
        <section id="sec-garage" class="hidden space-y-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-gray-900/60 p-6 rounded-2xl border border-gray-800">
                <div>
                    <h2 class="font-orbitron font-extrabold text-2xl text-white">GARAGEM DE PREPARAÇÃO</h2>
                    <p class="text-gray-400 text-sm">Instale melhorias de alta performance na sua moto atual.</p>
                </div>
                <div class="glass-panel px-6 py-3 rounded-xl border border-yellow-500/30 flex items-center gap-3">
                    <i class="fa-solid fa-coins text-yellow-400 text-2xl"></i>
                    <div>
                        <span class="text-xs text-gray-400 uppercase font-bold">Saldo Disponível</span>
                        <div class="font-orbitron font-black text-2xl text-yellow-400" id="cash-display-garage">R$ 1.500</div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Status Atuais -->
                <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-6">
                    <h3 class="font-orbitron font-bold text-lg text-red-400 border-b border-gray-800 pb-2 flex items-center gap-2">
                        <i class="fa-solid fa-motorcycle"></i> Especificações Atuais
                    </h3>

                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs font-bold text-gray-400 mb-1">
                                <span>Potência (HP)</span>
                                <span id="stat-power-val" class="text-white font-orbitron">150 CV</span>
                            </div>
                            <div class="w-full h-3 bg-gray-950 rounded-full overflow-hidden p-0.5 border border-gray-800">
                                <div id="stat-power-bar" class="h-full bg-red-500 rounded-full" style="width: 40%;"></div>
                            </div>
                        </div>

                        <div>
                            <div class="flex justify-between text-xs font-bold text-gray-400 mb-1">
                                <span>Velocidade Máx. Teórica</span>
                                <span id="stat-top-speed-val" class="text-white font-orbitron">220 KM/H</span>
                            </div>
                            <div class="w-full h-3 bg-gray-950 rounded-full overflow-hidden p-0.5 border border-gray-800">
                                <div id="stat-speed-bar" class="h-full bg-yellow-500 rounded-full" style="width: 50%;"></div>
                            </div>
                        </div>

                        <div>
                            <div class="flex justify-between text-xs font-bold text-gray-400 mb-1">
                                <span>Aderência / Tração</span>
                                <span id="stat-grip-val" class="text-white font-orbitron">60%</span>
                            </div>
                            <div class="w-full h-3 bg-gray-950 rounded-full overflow-hidden p-0.5 border border-gray-800">
                                <div id="stat-grip-bar" class="h-full bg-blue-500 rounded-full" style="width: 60%;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loja de Peças -->
                <div class="lg:col-span-2 glass-panel p-6 rounded-2xl border border-gray-800 space-y-4">
                    <h3 class="font-orbitron font-bold text-lg text-yellow-400 border-b border-gray-800 pb-2 flex items-center justify-between">
                        <span><i class="fa-solid fa-list-check mr-2"></i>Peças de Alta Performance</span>
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="upgrades-list">
                        <!-- Peças JS -->
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== TELA 4: RANKING & LEADERBOARD ==================== -->
        <section id="sec-ranking" class="hidden space-y-6">
            <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-4">
                <div class="flex justify-between items-center border-b border-gray-800 pb-4">
                    <div>
                        <h2 class="font-orbitron font-extrabold text-2xl text-yellow-400 flex items-center gap-2">
                            <i class="fa-solid fa-trophy"></i> LEADERBOARD DE TEMPOS (420 M)
                        </h2>
                        <p class="text-gray-400 text-sm">Confira os melhores tempos alcançados na pista.</p>
                    </div>
                    <button onclick="resetLeaderboard()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-xs font-bold text-gray-300 rounded-lg transition-all">
                        Resetar Tabela
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-gray-800 text-xs text-gray-400 font-orbitron uppercase">
                                <th class="p-3">Posição</th>
                                <th class="p-3">Piloto</th>
                                <th class="p-3">Moto / Prep</th>
                                <th class="p-3">Velocidade Máx.</th>
                                <th class="p-3">Tempo Final</th>
                            </tr>
                        </thead>
                        <tbody id="ranking-table-body" class="divide-y divide-gray-800/50 text-sm font-semibold">
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ==================== TELA 5: INFORMAÇÕES GRUPO 5 ==================== -->
        <section id="sec-info" class="hidden space-y-6">
            <div class="glass-panel p-8 rounded-2xl border border-gray-800 space-y-8">
                <div>
                    <span class="px-3 py-1 bg-red-600/30 text-red-400 rounded-full text-xs font-orbitron font-bold tracking-wider">PROTÓTIPO v2.0 • PROGRAMAÇÃO APLICADA</span>
                    <h2 class="font-orbitron font-black text-3xl text-white mt-2">PROJETO AUTO GIRO</h2>
                    <p class="text-gray-300 mt-2 max-w-3xl leading-relaxed">
                        Jogo interativo de corrida de arrancada focado na simulação de trocas de marcha, velocidade extrema e disputa contra oponentes na pista de 420 metros.
                    </p>
                </div>

                <div>
                    <h3 class="font-orbitron font-bold text-xl text-yellow-400 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-user-group"></i> Integrantes do Grupo 5
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <div class="bg-gray-900/80 p-4 rounded-xl border border-gray-800 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-600/20 text-red-400 flex items-center justify-center font-bold">MJ</div>
                            <div>
                                <div class="font-bold text-white">Maria Juliana Ferreira da Silva</div>
                                <div class="text-xs text-gray-500">Desenvolvimento / Planejamento</div>
                            </div>
                        </div>
                        <div class="bg-gray-900/80 p-4 rounded-xl border border-gray-800 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-yellow-600/20 text-yellow-400 flex items-center justify-center font-bold">AC</div>
                            <div>
                                <div class="font-bold text-white">Ana Cláudia Vieira da Silva</div>
                                <div class="text-xs text-gray-500">Design de UI / UX</div>
                            </div>
                        </div>
                        <div class="bg-gray-900/80 p-4 rounded-xl border border-gray-800 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-blue-600/20 text-blue-400 flex items-center justify-center font-bold">PQ</div>
                            <div>
                                <div class="font-bold text-white">Pedro Eduardo Queiroiz da Silva</div>
                                <div class="text-xs text-gray-500">Lógica e Física do Jogo</div>
                            </div>
                        </div>
                        <div class="bg-gray-900/80 p-4 rounded-xl border border-gray-800 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-purple-600/20 text-purple-400 flex items-center justify-center font-bold">PL</div>
                            <div>
                                <div class="font-bold text-white">Pedro Lucas Whylace Alves e Silva</div>
                                <div class="text-xs text-gray-500">Engenharia de Som e Efeitos</div>
                            </div>
                        </div>
                        <div class="bg-gray-900/80 p-4 rounded-xl border border-gray-800 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-green-600/20 text-green-400 flex items-center justify-center font-bold">JD</div>
                            <div>
                                <div class="font-bold text-white">José Daniel Barbosa dos Santos Silva</div>
                                <div class="text-xs text-gray-500">Desenvolvimento Backend / Rankings</div>
                            </div>
                        </div>
                        <div class="bg-gray-900/80 p-4 rounded-xl border border-gray-800 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-pink-600/20 text-pink-400 flex items-center justify-center font-bold">RV</div>
                            <div>
                                <div class="font-bold text-white">Ryan Valdemir Alvez da Silva</div>
                                <div class="text-xs text-gray-500">Testes e Garantia de Qualidade</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="border-t border-gray-800 bg-gray-950 py-4 text-center text-xs text-gray-500">
        Auto Giro © 2026 — Projeto de Programação Aplicada (Grupo 5). Todos os direitos reservados.
    </footer>

    <!-- LOGIC & GAME ENGINE SCRIPT -->
    <script>
        /* ==========================================================================
           1. BANCO DE DADOS DE MOTOS E CONFIGURAÇÕES
           ========================================================================== */
        const BIKES_DATABASE = [
            { id: 'street150', name: 'Street 150cc', price: 0, power: 120, topSpeed: 180, color: '#ef4444', desc: 'Moto de entrada leve e ágil.' },
            { id: 'sport300', name: 'Sport 300cc', price: 2500, power: 220, topSpeed: 250, color: '#3b82f6', desc: 'Boa aceleração com velocidade máxima superior.' },
            { id: 'supersport600', name: 'SuperSport 600cc', price: 6000, power: 360, topSpeed: 320, color: '#eab308', desc: 'Potência brutal nas marchas intermediárias.' },
            { id: 'racing1000', name: 'Racing 1000cc RR', price: 12000, power: 550, topSpeed: 420, color: '#a855f7', desc: 'Fórmula extrema de arrancada para tempos recordes.' }
        ];

        const gameState = {
            cash: 2500,
            currentBikeId: 'street150',
            ownedBikes: ['street150'],
            upgradesOwned: [],
            leaderboard: [
                { name: "Piloto Lenda", time: 7.210, speed: 385, bike: "Racing 1000cc RR" },
                { name: "Pedro Eduardo", time: 8.450, speed: 310, bike: "SuperSport 600cc" },
                { name: "Maria Juliana", time: 9.890, speed: 245, bike: "Sport 300cc" },
                { name: "Ana Cláudia", time: 11.200, speed: 180, bike: "Street 150cc" }
            ]
        };

        const UPGRADES_DATABASE = [
            { id: 'exhaust', name: 'Escapamento Dimensionado', cost: 600, powerBonus: 30, gripBonus: 0, desc: 'Aumenta a potência da moto em +30 CV.', icon: 'fa-wind' },
            { id: 'tires', name: 'Pneus Drag Slick', cost: 800, powerBonus: 0, gripBonus: 0.3, desc: 'Aumenta a tração inicial ao arrancar.', icon: 'fa-circle-dot' },
            { id: 'turbo', name: 'Kit Turbochargers', cost: 1800, powerBonus: 80, gripBonus: 0, desc: 'Aumento expressivo da aceleração.', icon: 'fa-gauge-simple-high' },
            { id: 'nitro', name: 'Injeção Nitro NOS', cost: 1500, powerBonus: 50, gripBonus: 0, hasNitro: true, desc: 'Permite acionar Nitro durante a corrida.', icon: 'fa-bolt' }
        ];

        /* ==========================================================================
           2. ESTADO DA CORRIDA E OPONENTE (BOT)
           ========================================================================== */
        let raceActive = false;
        let raceFinished = false;
        let countdownActive = false;
        
        let distance = 0;       // Metros do jogador (0 a 420m)
        let speed = 0;          // km/h jogador
        let rpm = 1000;         // RPM jogador
        let currentGear = 0;

        let botDistance = 0;    // Metros do oponente
        let botSpeed = 0;       // km/h oponente
        let botGear = 1;
        let botFinishTime = null;
        let playerFinishTime = null;

        let startTime = 0;
        let elapsedTime = 0;
        let animationFrameId = null;
        let isThrottling = false;
        let nitroAvailable = false;
        let nitroActive = false;

        const gearRatios = [0, 3.2, 2.3, 1.7, 1.3, 1.0, 0.85];

        /* ==========================================================================
           3. CANVAS E RENDERIZADOR GRÁFICO (DUAS MOTOS)
           ========================================================================== */
        const canvas = document.getElementById('raceCanvas');
        const ctx = canvas.getContext('2d');
        let roadOffset = 0;

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = 340;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function drawScene() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Céu Noturno com gradiente
            const skyGrad = ctx.createLinearGradient(0, 0, 0, canvas.height * 0.5);
            skyGrad.addColorStop(0, '#050811');
            skyGrad.addColorStop(1, '#111827');
            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, canvas.width, canvas.height * 0.5);

            // Luzes Distantes
            ctx.fillStyle = '#f59e0b';
            for (let i = 0; i < canvas.width; i += 50) {
                const height = (Math.sin(i + roadOffset * 0.05) * 12) + 25;
                ctx.fillRect(i, canvas.height * 0.5 - height, 10, height);
            }

            // Pista de Arrancada de Duas Faixas
            ctx.fillStyle = '#1f2937';
            ctx.fillRect(0, canvas.height * 0.5, canvas.width, canvas.height * 0.5);

            // Linha divisória de saída
            ctx.strokeStyle = '#ef4444';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(0, canvas.height * 0.5);
            ctx.lineTo(canvas.width, canvas.height * 0.5);
            ctx.stroke();

            // Divisória central das faixas de corrida
            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 2;
            ctx.setLineDash([15, 15]);
            ctx.beginPath();
            ctx.moveTo(0, canvas.height * 0.73);
            ctx.lineTo(canvas.width, canvas.height * 0.73);
            ctx.stroke();
            ctx.setLineDash([]); // Reset dash

            // Faixas do Asfalto Animadas
            ctx.fillStyle = '#ffffff';
            const stripeWidth = 50;
            const stripeGap = 40;
            const totalStripeWidth = stripeWidth + stripeGap;
            const effectiveOffset = (roadOffset * 10) % totalStripeWidth;

            for (let x = -totalStripeWidth; x < canvas.width + totalStripeWidth; x += totalStripeWidth) {
                ctx.fillRect(x - effectiveOffset, canvas.height * 0.93, stripeWidth, 5);
            }

            // Linha de Chegada de 420m
            const remainingDist = 420 - distance;
            if (remainingDist < 120) {
                const finishX = canvas.width - (remainingDist * 12);
                ctx.fillStyle = '#ffffff';
                for (let fy = canvas.height * 0.5; fy < canvas.height; fy += 16) {
                    ctx.fillRect(finishX, fy, 12, 8);
                    ctx.fillRect(finishX + 12, fy + 8, 12, 8);
                }
            }

            // Posições Relativas no Canvas
            // Moto do Jogador (Faixa de Baixo)
            const playerBikeConfig = getActiveBikeConfig();
            drawBike(130, canvas.height * 0.82, playerBikeConfig.color, "Você", nitroActive);

            // Moto Oponente / Bot (Faixa de Cima)
            // A posição X do Bot depende da diferença de distância percorrida
            const diffDist = botDistance - distance; // Em metros
            const botScreenX = 130 + (diffDist * 12); // Proporção visual
            drawBike(botScreenX, canvas.height * 0.62, '#06b6d4', "Oponente", false);
        }

        function drawBike(x, y, color, label, isNitro) {
            if (x < -60 || x > canvas.width + 60) return; // Fora da tela

            ctx.save();
            ctx.translate(x, y);

            // Efeito Fogo Nitro
            if (isNitro) {
                ctx.fillStyle = '#38bdf8';
                ctx.beginPath();
                ctx.moveTo(-35, 3);
                ctx.lineTo(-70, 0);
                ctx.lineTo(-35, -3);
                ctx.fill();
            }

            // Rodas
            ctx.fillStyle = '#0f172a';
            ctx.beginPath();
            ctx.arc(-22, 8, 14, 0, Math.PI * 2);
            ctx.arc(22, 8, 14, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(-22, 8, 14, 0, Math.PI * 2);
            ctx.arc(22, 8, 14, 0, Math.PI * 2);
            ctx.stroke();

            // Corpo da Moto
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.moveTo(-25, -3);
            ctx.lineTo(15, -12);
            ctx.lineTo(28, -3);
            ctx.lineTo(8, 8);
            ctx.lineTo(-18, 8);
            ctx.closePath();
            ctx.fill();

            // Piloto
            ctx.fillStyle = '#1e293b';
            ctx.beginPath();
            ctx.arc(-5, -18, 9, 0, Math.PI * 2);
            ctx.fill();

            // Viseira
            ctx.fillStyle = '#f59e0b';
            ctx.fillRect(0, -20, 5, 3);

            // Etiqueta Nome Piloto
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 11px Orbitron';
            ctx.fillText(label, -20, -32);

            ctx.restore();
        }

        /* ==========================================================================
           4. FÍSICA E INTELIGÊNCIA ARTIFICIAL DO BOT
           ========================================================================== */
        function getActiveBikeConfig() {
            const bike = BIKES_DATABASE.find(b => b.id === gameState.currentBikeId) || BIKES_DATABASE[0];
            let totalPower = bike.power;
            let totalGrip = 0.6;
            let hasNitro = false;

            gameState.upgradesOwned.forEach(upId => {
                const up = UPGRADES_DATABASE.find(u => u.id === upId);
                if (up) {
                    totalPower += up.powerBonus || 0;
                    totalGrip += up.gripBonus || 0;
                    if (up.hasNitro) hasNitro = true;
                }
            });

            return { ...bike, totalPower, totalGrip, hasNitro };
        }

        function updatePhysics() {
            if (!raceActive || raceFinished) return;

            const now = performance.now();
            elapsedTime = (now - startTime) / 1000;
            document.getElementById('time-display').innerText = elapsedTime.toFixed(3) + 's';

            const playerBike = getActiveBikeConfig();

            // ----------------- FÍSICA DO JOGADOR -----------------
            if (currentGear > 0) {
                let accelFactor = (playerBike.totalPower / 90) * (gearRatios[currentGear] || 1);

                if (isThrottling) {
                    rpm += (4000 / currentGear) * 0.05;
                } else {
                    rpm -= 2000 * 0.05;
                }

                if (nitroActive) {
                    accelFactor *= 2.0;
                    rpm += 300;
                }

                if (rpm > 14000) rpm = 14000;
                if (rpm < 1200) rpm = 1200;

                const targetSpeed = (rpm / 14000) * playerBike.topSpeed;
                speed += (targetSpeed - speed) * 0.1 * accelFactor;
            } else {
                if (isThrottling) rpm += 600;
                else rpm -= 400;
                if (rpm > 14000) rpm = 14000;
                if (rpm < 1000) rpm = 1000;
                speed *= 0.95;
            }

            const speedMps = (speed * 1000) / 3600;
            distance += speedMps * 0.016;
            roadOffset += speed * 0.025;

            if (distance >= 420 && !playerFinishTime) {
                playerFinishTime = elapsedTime;
            }

            // ----------------- FÍSICA E IA DO BOT -----------------
            // O bot usa uma IA que simula trocas de marcha e aceleração alta
            if (botDistance < 420) {
                const botTargetSpeed = playerBike.topSpeed * 0.94; // Oponente competitivo
                botSpeed += (botTargetSpeed - botSpeed) * 0.045;
                const botSpeedMps = (botSpeed * 1000) / 3600;
                botDistance += botSpeedMps * 0.016;
            } else if (!botFinishTime) {
                botFinishTime = elapsedTime;
            }

            // Checar Término da Corrida
            if (distance >= 420) {
                distance = 420;
                finishRace();
                return;
            }

            updateDashboardUI();
            drawScene();

            if (raceActive) {
                animationFrameId = requestAnimationFrame(updatePhysics);
            }
        }

        /* ==========================================================================
           5. CONTROLES DE MARCHA E TECLADO
           ========================================================================== */
        function shiftGear() {
            if (!raceActive || raceFinished) return;

            if (currentGear < 6) {
                const feedbackEl = document.getElementById('shift-feedback');
                if (rpm >= 10000 && rpm <= 13000) {
                    feedbackEl.innerText = "TROCA PERFEITA!";
                    feedbackEl.className = "text-green-400 font-orbitron font-bold neon-text-green";
                    speed += 20; // Bônus significativo de aceleração
                } else if (rpm > 13000) {
                    feedbackEl.innerText = "OVERREV! (Perdeu Força)";
                    feedbackEl.className = "text-red-400 font-orbitron font-bold";
                    speed *= 0.9;
                } else {
                    feedbackEl.innerText = "CEDO DEMAIS!";
                    feedbackEl.className = "text-yellow-400 font-orbitron font-bold";
                    speed *= 0.93;
                }

                currentGear++;
                rpm = Math.max(4000, rpm - 4500);
                updateDashboardUI();
            }
        }

        function useNitro() {
            if (nitroAvailable && raceActive && !nitroActive) {
                nitroActive = true;
                nitroAvailable = false;
                document.getElementById('nitro-status').innerText = "EM USO!";
                document.getElementById('nitro-status').className = "text-xs font-orbitron font-bold text-yellow-400 animate-pulse";
                
                setTimeout(() => {
                    nitroActive = false;
                    document.getElementById('nitro-status').innerText = "ESGOTADO";
                    document.getElementById('nitro-status').className = "text-xs font-orbitron font-bold text-gray-500";
                }, 2500);
            }
        }

        window.addEventListener('keydown', (e) => {
            if (e.code === 'KeyW' || e.code === 'Space') {
                isThrottling = true;
            }
            if (e.code === 'ArrowUp' || e.code === 'ShiftLeft') {
                e.preventDefault();
                shiftGear();
            }
            if (e.code === 'KeyN') {
                useNitro();
            }
        });

        window.addEventListener('keyup', (e) => {
            if (e.code === 'KeyW' || e.code === 'Space') {
                isThrottling = false;
            }
        });

        const throttleBtn = document.getElementById('btn-throttle');
        throttleBtn.addEventListener('mousedown', () => isThrottling = true);
        throttleBtn.addEventListener('mouseup', () => isThrottling = false);
        throttleBtn.addEventListener('touchstart', (e) => { e.preventDefault(); isThrottling = true; });
        throttleBtn.addEventListener('touchend', (e) => { e.preventDefault(); isThrottling = false; });

        /* ==========================================================================
           6. ARVORE DE LARGADA E CONCLUSÃO DE PROVA
           ========================================================================== */
        function startRaceSequence() {
            if (countdownActive) return;

            distance = 0;
            botDistance = 0;
            speed = 0;
            botSpeed = 0;
            rpm = 1000;
            currentGear = 0;
            raceActive = false;
            raceFinished = false;
            countdownActive = true;
            playerFinishTime = null;
            botFinishTime = null;

            const playerBike = getActiveBikeConfig();
            nitroAvailable = playerBike.hasNitro;

            document.getElementById('nitro-status').innerText = nitroAvailable ? "PRONTO" : "NÃO EQUIPADO";
            document.getElementById('nitro-status').className = nitroAvailable ? "text-xs font-orbitron font-bold text-cyan-400" : "text-xs text-gray-500";
            document.getElementById('race-status-banner').classList.add('hidden');

            const redL = document.getElementById('light-red');
            const yel1 = document.getElementById('light-yellow1');
            const yel2 = document.getElementById('light-yellow2');
            const grnL = document.getElementById('light-green');

            redL.className = "w-5 h-5 rounded-full bg-red-950 border border-red-800";
            yel1.className = "w-5 h-5 rounded-full bg-yellow-950 border border-yellow-800";
            yel2.className = "w-5 h-5 rounded-full bg-yellow-950 border border-yellow-800";
            grnL.className = "w-5 h-5 rounded-full bg-green-950 border border-green-800";

            setTimeout(() => { redL.className = "w-5 h-5 rounded-full bg-red-600 border border-red-400 shadow-[0_0_12px_#ef4444]"; }, 500);
            setTimeout(() => { yel1.className = "w-5 h-5 rounded-full bg-yellow-400 border border-yellow-200 shadow-[0_0_12px_#eab308]"; }, 1400);
            setTimeout(() => { yel2.className = "w-5 h-5 rounded-full bg-yellow-400 border border-yellow-200 shadow-[0_0_12px_#eab308]"; }, 2300);
            setTimeout(() => {
                grnL.className = "w-5 h-5 rounded-full bg-green-500 border border-green-200 shadow-[0_0_15px_#22c55e]";
                
                raceActive = true;
                countdownActive = false;
                currentGear = 1;
                startTime = performance.now();
                updatePhysics();
            }, 3200);
        }

        function finishRace() {
            raceActive = false;
            raceFinished = true;

            const finalTime = elapsedTime.toFixed(3);
            const finalSpeed = Math.round(speed);
            const playerWon = distance >= 420 && (botDistance < 420 || playerFinishTime <= botFinishTime);

            let reward = playerWon ? 800 : 300;
            gameState.cash += reward;
            updateCashDisplays();

            const playerBike = getActiveBikeConfig();
            gameState.leaderboard.push({
                name: "Você (Jogador)",
                time: parseFloat(finalTime),
                speed: finalSpeed,
                bike: playerBike.name
            });
            gameState.leaderboard.sort((a, b) => a.time - b.time);
            renderLeaderboard();

            const banner = document.getElementById('race-status-banner');
            document.getElementById('status-title').innerText = playerWon ? "VITÓRIA ESPETACULAR!" : "DERROTA NA ARRANCADA!";
            document.getElementById('status-title').className = `font-orbitron text-4xl font-black tracking-wider ${playerWon ? 'text-green-400' : 'text-red-500'}`;
            
            document.getElementById('status-subtitle').innerHTML = `
                Seu Tempo: <span class="text-green-400 font-bold">${finalTime}s</span> | Vel. Máx: <span class="text-yellow-400 font-bold">${finalSpeed} km/h</span><br>
                Resultado: <span class="${playerWon ? 'text-green-400' : 'text-red-400'} font-bold">${playerWon ? 'Você cruzou a linha em 1º lugar!' : 'O oponente chegou antes!'}</span><br>
                Recompensa: <span class="text-yellow-400 font-bold">R$ ${reward}</span>
            `;
            banner.classList.remove('hidden');
        }

        /* ==========================================================================
           7. DASHBOARD E CONCESSIONÁRIA DE MOTOS
           ========================================================================== */
        function updateDashboardUI() {
            document.getElementById('dist-display').innerText = `${distance.toFixed(1)} m / 420m`;
            document.getElementById('bot-dist-display').innerText = `${botDistance.toFixed(1)} m`;
            document.getElementById('speed-display').innerText = Math.round(speed);
            document.getElementById('gear-indicator').innerText = currentGear === 0 ? 'N' : currentGear;
            document.getElementById('rpm-text').innerText = Math.round(rpm);

            const bike = getActiveBikeConfig();
            document.getElementById('current-bike-name-display').innerText = `Moto: ${bike.name}`;

            const rpmPct = Math.min(100, (rpm / 14000) * 100);
            document.getElementById('rpm-bar').style.width = `${rpmPct}%`;

            const shiftLightsContainer = document.getElementById('shift-lights').children;
            const step = 14000 / 8;

            for (let i = 0; i < 8; i++) {
                const threshold = (i + 1) * step;
                if (rpm >= threshold) {
                    if (i < 4) shiftLightsContainer[i].className = "h-3 rounded bg-green-500 shadow-[0_0_8px_#22c55e]";
                    else if (i < 6) shiftLightsContainer[i].className = "h-3 rounded bg-yellow-400 shadow-[0_0_8px_#eab308]";
                    else shiftLightsContainer[i].className = "h-3 rounded bg-red-600 shadow-[0_0_8px_#ef4444] animate-pulse";
                } else {
                    shiftLightsContainer[i].className = "h-3 rounded bg-gray-800 shadow-inner";
                }
            }
        }

        function updateCashDisplays() {
            document.getElementById('cash-display-bikes').innerText = `R$ ${gameState.cash.toLocaleString()}`;
            document.getElementById('cash-display-garage').innerText = `R$ ${gameState.cash.toLocaleString()}`;
        }

        function renderBikesCatalog() {
            const container = document.getElementById('bikes-catalog-list');
            container.innerHTML = '';

            BIKES_DATABASE.forEach(bike => {
                const isOwned = gameState.ownedBikes.includes(bike.id);
                const isSelected = gameState.currentBikeId === bike.id;

                const card = document.createElement('div');
                card.className = `glass-panel p-5 rounded-2xl border flex flex-col justify-between space-y-4 ${isSelected ? 'border-yellow-400 ring-2 ring-yellow-400/30' : 'border-gray-800'}`;

                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-orbitron font-extrabold text-lg text-white">${bike.name}</h3>
                            <span class="w-4 h-4 rounded-full" style="background-color: ${bike.color}"></span>
                        </div>
                        <p class="text-xs text-gray-400 mb-4">${bike.desc}</p>
                        
                        <div class="space-y-2 text-xs font-semibold">
                            <div class="flex justify-between">
                                <span class="text-gray-400">Potência:</span>
                                <span class="text-red-400 font-orbitron">${bike.power} CV</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-400">Velocidade Máx:</span>
                                <span class="text-yellow-400 font-orbitron">${bike.topSpeed} km/h</span>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-gray-800/80">
                        ${isSelected 
                            ? `<button disabled class="w-full py-2.5 bg-yellow-500/20 text-yellow-400 border border-yellow-500/50 font-orbitron font-bold text-xs rounded-xl">SELECIONADA</button>`
                            : isOwned 
                            ? `<button onclick="selectBike('${bike.id}')" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-orbitron font-bold text-xs rounded-xl transition-all">PILOTAR ESTA MOTO</button>`
                            : `<button onclick="buyBike('${bike.id}')" class="w-full py-2.5 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-500 hover:to-emerald-500 text-white font-orbitron font-bold text-xs rounded-xl shadow-lg transition-all">COMPRAR R$ ${bike.price.toLocaleString()}</button>`
                        }
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function buyBike(id) {
            const bike = BIKES_DATABASE.find(b => b.id === id);
            if (!bike) return;

            if (gameState.cash >= bike.price) {
                gameState.cash -= bike.price;
                gameState.ownedBikes.push(id);
                gameState.currentBikeId = id;
                updateCashDisplays();
                renderBikesCatalog();
                renderGarage();
                drawScene();
            } else {
                alert("Saldo insuficiente para comprar esta moto!");
            }
        }

        function selectBike(id) {
            gameState.currentBikeId = id;
            renderBikesCatalog();
            renderGarage();
            drawScene();
        }

        /* ==========================================================================
           8. GARAGEM E LOJA DE UPGRADES DE PEÇAS
           ========================================================================== */
        function renderGarage() {
            const container = document.getElementById('upgrades-list');
            container.innerHTML = '';

            UPGRADES_DATABASE.forEach(item => {
                const isBought = gameState.upgradesOwned.includes(item.id);
                
                const card = document.createElement('div');
                card.className = `p-4 rounded-xl border flex flex-col justify-between ${isBought ? 'bg-gray-900/40 border-green-500/40' : 'bg-gray-900 border-gray-800'}`;
                
                card.innerHTML = `
                    <div class="flex items-start gap-3">
                        <div class="p-3 bg-gray-800 rounded-lg text-yellow-400 text-xl">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-white text-base">${item.name}</h4>
                            <p class="text-xs text-gray-400 mt-1">${item.desc}</p>
                        </div>
                    </div>
                    <div class="flex justify-between items-center mt-4 pt-3 border-t border-gray-800/60">
                        <span class="font-orbitron font-bold text-yellow-400">R$ ${item.cost}</span>
                        ${isBought 
                            ? `<span class="text-xs font-bold text-green-400 bg-green-950 px-3 py-1 rounded-full border border-green-800"><i class="fa-solid fa-check mr-1"></i> Instalado</span>`
                            : `<button onclick="buyUpgrade('${item.id}')" class="px-3 py-1.5 bg-yellow-500 hover:bg-yellow-400 text-black font-bold text-xs rounded-lg transition-all">Comprar</button>`
                        }
                    </div>
                `;
                container.appendChild(card);
            });

            const current = getActiveBikeConfig();
            document.getElementById('stat-power-val').innerText = `${current.totalPower} CV`;
            document.getElementById('stat-power-bar').style.width = `${Math.min(100, (current.totalPower / 650) * 100)}%`;

            document.getElementById('stat-top-speed-val').innerText = `${current.topSpeed} KM/H`;
            document.getElementById('stat-speed-bar').style.width = `${Math.min(100, (current.topSpeed / 450) * 100)}%`;

            document.getElementById('stat-grip-val').innerText = `${Math.round(current.totalGrip * 100)}%`;
            document.getElementById('stat-grip-bar').style.width = `${Math.round(current.totalGrip * 100)}%`;
        }

        function buyUpgrade(id) {
            const item = UPGRADES_DATABASE.find(u => u.id === id);
            if (!item) return;

            if (gameState.cash >= item.cost && !gameState.upgradesOwned.includes(id)) {
                gameState.cash -= item.cost;
                gameState.upgradesOwned.push(id);
                updateCashDisplays();
                renderGarage();
            } else if (gameState.cash < item.cost) {
                alert("Saldo insuficiente para comprar esta peça!");
            }
        }

        /* ==========================================================================
           9. LEADERBOARD / RANKING
           ========================================================================== */
        function renderLeaderboard() {
            const tbody = document.getElementById('ranking-table-body');
            tbody.innerHTML = '';

            gameState.leaderboard.forEach((entry, index) => {
                const tr = document.createElement('tr');
                tr.className = index === 0 ? "bg-yellow-500/10 text-yellow-300 font-bold" : "hover:bg-gray-800/40";
                
                tr.innerHTML = `
                    <td class="p-3 font-orbitron">#${index + 1}</td>
                    <td class="p-3 font-semibold text-white">${entry.name}</td>
                    <td class="p-3 text-gray-400 text-xs">${entry.bike}</td>
                    <td class="p-3 text-red-400 font-orbitron">${entry.speed} km/h</td>
                    <td class="p-3 text-green-400 font-orbitron font-bold">${entry.time.toFixed(3)}s</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function resetLeaderboard() {
            gameState.leaderboard = [
                { name: "Piloto Lenda", time: 7.210, speed: 385, bike: "Racing 1000cc RR" },
                { name: "Pedro Eduardo", time: 8.450, speed: 310, bike: "SuperSport 600cc" }
            ];
            renderLeaderboard();
        }

        /* ==========================================================================
           10. NAVEGAÇÃO DE TABS
           ========================================================================== */
        function switchTab(tabId) {
            ['race', 'bikes', 'garage', 'ranking', 'info'].forEach(id => {
                const sec = document.getElementById(`sec-${id}`);
                const btn = document.getElementById(`tab-${id}`);
                
                if (id === tabId) {
                    sec.classList.remove('hidden');
                    btn.className = "px-4 py-2 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 bg-red-600 text-white shadow-md";
                } else {
                    sec.classList.add('hidden');
                    btn.className = "px-4 py-2 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 text-gray-400 hover:text-white hover:bg-gray-800";
                }
            });

            if (tabId === 'bikes') renderBikesCatalog();
            if (tabId === 'garage') renderGarage();
            if (tabId === 'ranking') renderLeaderboard();
            if (tabId === 'race') drawScene();
        }

        window.onload = function () {
            drawScene();
            renderBikesCatalog();
            renderGarage();
            renderLeaderboard();
            document.getElementById('race-status-banner').classList.remove('hidden');
        };

    </script>
</body>
</html>
